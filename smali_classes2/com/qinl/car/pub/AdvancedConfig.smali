    const-string v8, "\u2605\u2605\u2605 3.16.43 \u5b9a\u6848\u30013.16.51 \u8d77\u89e3\u9501\u65b9\u5411\u53ea\u6709\u4e00\u4e2a\u65cb\u94ae\uff1a**\u8c03\u8fd9\u4e00\u4e2a\u5c31\u591f**\u3002\u7cfb\u7edf\u6309\u5b83\u81ea\u52a8\u751f\u6210\u5168\u90e8\u89e3\u9501\u4fa7\u66f2\u7387\u5224\u636e\uff1a<br>\u00b7 **\u592a\u7f13\u7684\u4e0d\u7b97** \u2014\u2014 \u7a97\u5185\u51c0\u6da8\u5e45\u81f3\u5c11\u8981 \u57fa\u51c6\u00d70.6\uff08\u9ed8\u8ba4 8 \u2192 4.8dB\uff09\u3002\u5e73\u7ebf\u4e0a 2dB \u7684\u6296\u52a8\u3001\u7ad9\u7740\u6f02\u79fb\uff0c\u5168\u90e8\u4e0d\u5224\uff1b<br>\u00b7 **\u592a\u9661\u7684\u4e0d\u7b97** \u2014\u2014 \u6bcf\u79d2\u6da8\u5e45\u8d85\u8fc7\u300c\u6700\u7f13\u5761\u5ea6\u00d73\u300d\u89c6\u4e3a\u7a81\u53d8\uff08\u53f0\u9636\u3001\u65ad\u6863\u8df3\u53d8\u3001\u638f\u624b\u673a\uff09\uff0c\u62d2\u5224\uff1b<br>\u00b7 **\u62d0\u592a\u6025\u7684\u4e0d\u7b97** \u2014\u2014 \u7a97\u5185\u4e8c\u9636\u5dee\u5206\u8d85\u8fc7 \u57fa\u51c6\u00d72\uff08**\u4e0d\u4f4e\u4e8e 14dB**\uff1a\u504f\u79fb\u515c\u5e95\uff0c\u57fa\u51c6\u8c03\u5230 3~6 \u65f6\u5f2f\u6298\u4e0a\u9650\u4ecd\u6309 14 \u7b97\uff0c\u5426\u5219\u4eba\u8d34\u8f66\u7ad9\u5b9a\u7684 11~14dB \u6b63\u5e38\u6296\u52a8\u4f1a\u88ab\u5f53\u6210\u53f0\u9636\uff09\u62d2\u5224\uff1b<br>\u00b7 **\u7ed5\u8def\u7684\u4e0d\u7b97** \u2014\u2014 \u7ed5\u8def\u6bd4\u4e0a\u9650\u4e5f\u7531\u57fa\u51c6\u63a8\u5bfc\uff08\u57fa\u51c6\u00d72\uff0c\u9ed8\u8ba4 R\u22641.6\uff09\u3002<br>\u5168\u90e8\u6309\u300c\u8d8b\u52bf\u8de8\u5ea6\u300d\u81ea\u52a8\u6362\u7b97\uff0c\u8de8\u5ea6\u6539\u4e86\u4e0d\u7528\u91cd\u8c03\u3002<br>\u26a0 3.18.1 \u8d77\u672c\u9879<b>\u53ea\u8d1f\u8d23\u89e3\u9501\uff08\u8d70\u8fd1\uff09</b>\uff0c\u9501\u8f66\uff08\u8d70\u8fdc\uff09\u6539\u7528\u4e0b\u9762\u72ec\u7acb\u7684\u300c\u9501\u8f66\u66f2\u7387\u57fa\u51c6\u300d\u3002<br>\u8c03\u5927 = \u66f4\u4e25\uff08\u8981\u6c42\u4fe1\u53f7\u53d8\u5316\u66f4\u660e\u786e\uff0c\u4ee3\u4ef7\u662f\u6162\u8d70\u8fd1\u53ef\u80fd\u89e3\u4e0d\u5f00\uff09\uff1b\u8c03\u5c0f = \u66f4\u677e\u3002\u9ed8\u8ba4 8\u3002"

